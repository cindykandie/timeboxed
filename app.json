{
  "expo": {
    "name": "TimeBoxed",
    "slug": "timeboxed",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "timeboxed",
    "experiments": {
      "typedRoutes": true
    },
    "platforms": ["android"],
    "android": {
      "package": "com.timeboxed.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "./plugins/with-pointer-events.cjs",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "androidTVIcon": "./assets/icon.png"
        }
      ]
    ]
  }
}
